# ---------------------------------------------------------------------------
# MarketPulse AI backend configuration
# Copy this file to backend/.env and adjust. Never commit backend/.env.
# ---------------------------------------------------------------------------

# Application
APP_NAME="MarketPulse AI Backend"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# CORS: comma-separated origins allowed to call the API
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ---------------------------------------------------------------------------
# Database (MySQL only)
# ---------------------------------------------------------------------------
# Option A - Docker (the default in docker-compose.yml, host port 3307):
DATABASE_URL="mysql+pymysql://marketpulse:marketpulse@127.0.0.1:3307/marketpulse"
#
# Option B - MySQL installed natively on your machine (default port 3306):
# DATABASE_URL="mysql+pymysql://marketpulse:marketpulse@127.0.0.1:3306/marketpulse"
#
# Option C - a shared MySQL server (ask the team for host and credentials):
# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE"
#
# The team shares one database during the prototype, so all teammates should
# point at the same server. Use Option A or B only for your own scratch copy.

DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# OpenRouter (LLM)
# Leave both empty to run without an LLM: the AI surfaces fall back to the
# deterministic engine and the API reports "derived" instead of "llm".
# Get a key at https://openrouter.ai/keys and pick a free model id.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=900
OPENROUTER_APP_NAME="MarketPulse AI"
OPENROUTER_APP_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# External connectors
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="MarketPulseAI/1.0 by MarketPulseTeam"

TWITTER_BEARER_TOKEN=""

EMAG_REQUEST_TIMEOUT=15
EMAG_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
EMAG_RATE_LIMIT_DELAY=1.5
