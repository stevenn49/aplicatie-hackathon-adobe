# ---------------------------------------------------------------------------
# MarketPulse AI backend configuration
#
# Copy this file to backend/.env, or let scripts/setup.ps1 / scripts/setup.sh
# generate it for you (they ask for the database and the API keys).
# Never commit backend/.env.
# ---------------------------------------------------------------------------

# Application
APP_NAME="MarketPulse AI Backend"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"
PORT=8010
HOST="0.0.0.0"

# CORS: comma-separated origins allowed to call the API
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ---------------------------------------------------------------------------
# Database (MySQL only)
# ---------------------------------------------------------------------------
# Option A - Docker (docker-compose.yml, host port 3307):
DATABASE_URL="mysql+pymysql://marketpulse:marketpulse@127.0.0.1:3307/marketpulse"
#
# Option B - MySQL installed natively (default port 3306):
# DATABASE_URL="mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/marketpulse"
#
# Option C - a shared MySQL server (ask the team for host and credentials):
# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/marketpulse"
#
# The team shares one database during the prototype. Use a local container only
# for your own scratch work.

DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# LLM - OpenRouter (optional)
# Powers the AI Recommendations executive summary, the product review summary
# and the marketing opportunities. Without a key those surfaces use the
# deterministic engine and the API reports "source": "derived".
#   Key:    https://openrouter.ai/keys
#   Models: https://openrouter.ai/models?max_price=0
#
# The default is a free model with a 1M-token context. The setup and the
# settings manager list every free model from the live catalogue, marking the
# ones with a 1M or 256k context.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="stealth/crouton-alpha"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=900
OPENROUTER_APP_NAME="MarketPulse AI"
OPENROUTER_APP_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# AI assistant - backend/server.py (optional, separate service)
# The "Ask AI" panel and the per-chart "Analyse" button.
#   provider: ollama | groq | gemini
#   ollama  runs on your machine, no key   https://ollama.com/download
#   groq    free key                       https://console.groq.com/keys
#   gemini  free key                       https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
GROQ_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
OLLAMA_NUM_CTX=8192
AI_TIMEOUT=120
# Optional: comma-separated model ids tried in order (overrides the defaults)
# AI_MODELS=llama3.2

# ---------------------------------------------------------------------------
# Data source connectors
# ---------------------------------------------------------------------------
# eMAG: public catalogue, HTML parsing, no key.
EMAG_REQUEST_TIMEOUT=15
EMAG_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
EMAG_RATE_LIMIT_DELAY=1.5

# Reddit: public .json endpoints, no key. A descriptive User-Agent is polite
# and reduces the chance of being rate-limited.
REDDIT_USER_AGENT="MarketPulseAI/1.0 by MarketPulseTeam"
# Reserved for the authenticated OAuth mode; the connector does not use them yet.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# X / Twitter: v2 API, bearer token required.
#   https://developer.x.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=""

# Google Trends: pytrends, no key.
# Hacker News: Algolia search API, no key.
