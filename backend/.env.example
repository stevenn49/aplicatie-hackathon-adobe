# Application Configuration
APP_NAME="MarketPulse AI Backend"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins for React Frontend)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration
# PostgreSQL connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local development without PostgreSQL running, SQLite fallback is supported: sqlite:///./marketpulse.db
DATABASE_URL="sqlite:///./marketpulse.db"

# Reddit API Credentials (for connectors/reddit.py)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="MarketPulseAI/1.0 by MarketPulseTeam"

# Twitter / X API Credentials (for connectors/twitter.py)
TWITTER_BEARER_TOKEN=""

# eMAG Connector Scraping Configuration
EMAG_REQUEST_TIMEOUT=15
EMAG_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
EMAG_RATE_LIMIT_DELAY=1.5

# AI Assistant chat (advisor.py / assistant.py / server.py)
# Which AI provider to use: ollama | groq | gemini
AI_PROVIDER=ollama

# Free keys (only needed for groq or gemini):
GROQ_API_KEY=         # https://console.groq.com/keys
GEMINI_API_KEY=       # https://aistudio.google.com/apikey
# Ollama needs no key: install https://ollama.com, then `ollama pull llama3.2`
# OLLAMA_URL=http://localhost:11434

# Optional: comma-separated models to try in order (overrides the provider defaults)
# AI_MODELS=llama3.2
