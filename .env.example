# Frontend configuration. Copy to .env.local and adjust if needed.
#
# The main API runs on 8010 in this project because port 8000 is used by another
# local service on the development machine. Change this if you run the API
# elsewhere (see backend/.env PORT).
VITE_API_URL=http://localhost:8010

# Optional: the separate AI assistant service (backend/server.py, Ollama/Groq/Gemini).
# Leave empty to hide the assistant; the dashboard works without it.
VITE_AI_API_URL=
